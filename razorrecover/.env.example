# Copy this to .env and fill in your real values — never commit .env itself

# Get this from Razorpay Dashboard > Settings > Webhooks, when you create the webhook
RAZORPAY_WEBHOOK_SECRET=

# Get these from Razorpay Dashboard > Settings > API Keys (use TEST mode keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Only needed from Phase 3 onward (LLM classification of ambiguous failures)
GEMINI_API_KEY=

# Defaults to local SQLite if unset — fine for the whole build
DATABASE_URL=sqlite:///./razorrecover.db
